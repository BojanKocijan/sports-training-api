# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Project Settings -> API -> service_role key. Server-side ONLY — never send this to a
# browser. It bypasses Row Level Security, which is why the passcode check in
# src/routes/plans.ts (via the verify_passcode RPC) is what actually gates writes now,
# not RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

PORT=3001

# Comma-separated list of origins allowed to call this API (your frontend's URL(s)).
ALLOWED_ORIGINS=http://localhost:5173,https://sports-training-planner.netlify.app
