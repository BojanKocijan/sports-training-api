    "@types/express": "^5.0.0",
    "@types/node": "^24.13.3",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "oxlint": "^1.81.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
